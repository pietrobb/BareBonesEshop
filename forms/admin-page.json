{
    "$schema": "../vendor/bbf/forms/form.schema.json",
    "schema_version": 1,
    "id": "admin-page",
    "name": "CMS Stránka",
    "submit_label": "Uložiť",
    "submitting_label": "Ukladám...",
    "success_message": "Stránka uložená.",
    "fields": [
        {
            "name": "slug",
            "type": "text",
            "label": "Slug",
            "required": true
        },
        {
            "name": "title",
            "type": "text",
            "label": "Názov",
            "required": true
        },
        {
            "name": "body",
            "type": "textarea",
            "label": "Obsah (HTML)",
            "rows": 15
        },
        {
            "name": "page_type",
            "type": "text",
            "label": "Typ stránky"
        },
        {
            "name": "template",
            "type": "text",
            "label": "Theme page template"
        },
        {
            "name": "layout",
            "type": "text",
            "label": "Theme layout"
        },
        {
            "name": "sections",
            "type": "textarea",
            "label": "Sekcie (JSON; type sa mapuje cez theme manifest)",
            "rows": 12
        },
        {
            "name": "status",
            "type": "select",
            "label": "Stav",
            "options_from": "/api/v1/options/page_statuses"
        }
    ],
    "on_submit": {
        "store": false,
        "actions": [
            {"type": "eshop-page-save"}
        ]
    }
}
