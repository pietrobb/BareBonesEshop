{
    "$schema": "../vendor/bbf/forms/form.schema.json",
    "schema_version": 1,
    "id": "checkout",
    "name": "Objednávka",
    "submit_label": "Odoslať objednávku",
    "submitting_label": "Spracovávam...",
    "success_message": "Objednávka bola odoslaná. Ďakujeme!",
    "fields": [
        {
            "name": "_section_contact",
            "type": "heading",
            "label": "Kontaktné údaje"
        },
        {
            "name": "name",
            "type": "text",
            "label": "Meno a priezvisko",
            "required": true,
            "minlength": 2,
            "maxlength": 100,
            "size": "half"
        },
        {
            "name": "email",
            "type": "email",
            "label": "Email",
            "required": true,
            "size": "half"
        },
        {
            "name": "phone",
            "type": "tel",
            "label": "Telefón",
            "required": true,
            "size": "half"
        },
        {
            "name": "_section_address",
            "type": "heading",
            "label": "Doručovacia adresa"
        },
        {
            "name": "street",
            "type": "text",
            "label": "Ulica a číslo",
            "required": true
        },
        {
            "name": "city",
            "type": "text",
            "label": "Mesto",
            "required": true,
            "size": "half"
        },
        {
            "name": "zip",
            "type": "text",
            "label": "PSČ",
            "required": true,
            "pattern": "[0-9]{3}\\s?[0-9]{2}",
            "size": "half"
        },
        {
            "name": "country",
            "type": "select",
            "label": "Krajina",
            "required": true,
            "options": [
                {"value": "SK", "label": "Slovensko"},
                {"value": "CZ", "label": "Česko"},
                {"value": "DE", "label": "Nemecko"},
                {"value": "AT", "label": "Rakúsko"},
                {"value": "HU", "label": "Maďarsko"},
                {"value": "PL", "label": "Poľsko"}
            ]
        },
        {
            "name": "_section_payment",
            "type": "heading",
            "label": "Doprava a platba"
        },
        {
            "name": "payment",
            "type": "radio",
            "label": "Spôsob platby",
            "required": true,
            "options": [
                {"value": "cod", "label": "Dobierka"},
                {"value": "transfer", "label": "Bankový prevod"},
                {"value": "card", "label": "Kartou online"}
            ]
        },
        {
            "name": "notes",
            "type": "textarea",
            "label": "Poznámka k objednávke",
            "rows": 3,
            "maxlength": 1000
        }
    ],
    "on_submit": {
        "store": true,
        "actions": [
            {"type": "eshop-checkout"}
        ],
        "confirm_email": {
            "to": "{{email}}",
            "subject": "Objednávka prijatá — Woodle.sk"
        }
    }
}
