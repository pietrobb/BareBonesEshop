RewriteEngine On

# Deny private/runtime/source trees before the generic existing-file bypass.
RewriteRule ^(?:storage|db|jobs|logs|config|cli|src|migrations|adapters|extensions|lang|demo|docs|forms|blocks|data|templates|releases|tests|deploy|node_modules|test-results|playwright-report|parity-report)(?:/|$) - [F,L,NC]
RewriteRule ^themes/[^/]+/(?:theme\.json|blocks(?:/|$)) - [F,L,NC]

# BBF's browser client and handler are public integration points; all other
# vendor code stays private. Only the documented import example is public.
RewriteRule ^vendor/(?!bbf/(?:bbf\.(?:css|js)|submit\.php)$) - [F,L,NC]
# On Apache that rule never sees vendor/bbf/*: vendor/bbf/.htaccess turns on its own
# rewrite engine, which replaces the root rules there (editor.php, viewer.php, demos...
# were served). The <If> authz block applies below it as well. Only existing files and
# directories are matched, so storefront URLs with a "vendor" segment keep working.
<If "(-f %{REQUEST_FILENAME} || -d %{REQUEST_FILENAME}) && %{REQUEST_URI} =~ m#/vendor/(?!bbf/(?:bbf\.(?:css|js)|submit\.php)$)#i">
    Require all denied
</If>
# Admin forms (forms/admin-*.json) are rendered and saved only by admin.php, so
# BBF's public handler must not serve, issue CSRF for, or accept them.
# BBF reads the form id only from the query string and strips everything except
# [A-Za-z0-9_-], so encoded, padded or junk-laden ids are refused as well.
# Storefront BBF forms (e.g. statutory withdrawal) keep using submit.php.
# <If>, not RewriteRule: vendor/bbf/.htaccess enables its own rewrite engine,
# which replaces these root rewrite rules for everything under vendor/bbf/.
<If "%{REQUEST_URI} =~ m#/vendor/bbf/submit\.php$#i && %{QUERY_STRING} =~ m#[%+]|(?:^|[&;])form=(?:[^&;]*[^A-Za-z0-9_&;-]|admin-)#i">
    Require all denied
</If>
RewriteRule ^import/(?!test-products\.csv$) - [F,L,NC]

# Deny direct cache requests (the file cache is read only through PHP).
RewriteCond %{THE_REQUEST} "\s/+(?:[^?\s]+/)?cache(?:[/\s?]|$)" [NC]
RewriteRule ^cache(?:/|$) - [F,L,NC]

# Keep ACME validation and security.txt available, deny all other dotfiles.
RewriteRule ^\.well-known/(?:acme-challenge/[A-Za-z0-9_-]+|security\.txt)$ - [L,NC]
RewriteRule (?:^|/)\. - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|router\.php|stores\.json|catalog\.json|shipping\.json|tax\.json|pricing\.json|layouts\.json|admin-roles\.json|models\.yaml|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]
RewriteRule \.(?:(?:sqlite3?|db)(?:-(?:wal|shm))?|wal|shm|sql|dump|bak|backup|log|lock|ini|ya?ml|pem|key|md|neon(?:\.dist)?)$ - [F,L,NC]

# Uploaded content must never be dispatched through a PHP handler.
RewriteRule ^uploads/.*\.(?:php(?:[0-9]+|s)?|phtml?|phar)(?:[./]|$) - [F,L,NC]

# No web-server cache shortcut: api.php serves its file cache itself, because entries live under
# the resolved store namespace (cache/stores/<store>/<channel>/...) and are skipped for logged-in
# customers with personal prices — neither is visible to Apache.

# ============================================================
# SEO-friendly URLs
# ============================================================

# XML sitemap, robots.txt, and store-scoped commerce feeds
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^feeds/google\.xml$ feed.php?channel=google [QSA,L]
RewriteRule ^feeds/meta\.csv$ feed.php?channel=meta [QSA,L]

# Store URL prefixes (/cs/..., /de/..., any url_prefix in stores.json) are served by the
# redirect.php fallback below (UrlAliases::storeRoute), so adding a store needs no rule here.

# Product detail: /product/brzdovy-kotuc-predny → product.php?slug=brzdovy-kotuc-predny
RewriteRule ^product/([a-z0-9-]+)/?$ product.php?slug=$1 [QSA,L]

# Category: /category/brzdovy-system → index.php?category=brzdovy-system
RewriteRule ^category/([a-z0-9/-]+)/?$ index.php?category=$1 [QSA,L]

# CMS Page: /page/about → page.php?slug=about
RewriteRule ^page/([a-z0-9-]+)/?$ page.php?slug=$1 [QSA,L]

# Wishlist: /wishlist → wishlist.php
RewriteRule ^wishlist/?$ wishlist.php [QSA,L]

# Public load-balancer probes expose no configuration or exception detail.
RewriteRule ^(?:healthz|readyz)$ health.php [QSA,L]

# Versioned machine API keeps path semantics; legacy browser API stays action-based.
RewriteRule ^api/v1(?:/.*)?$ api/v1/index.php [QSA,L]
# API routing: /api/products → api.php?action=products
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

# ============================================================
# Static assets — skip rewriting; never expose directory listings
# ============================================================
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.+/?$ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Exact-path redirects managed in admin; unmatched paths remain a real 404.
RewriteRule ^(.+)$ redirect.php?path=/$1 [QSA,L]

# ============================================================
# Compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ============================================================
# Cache headers for static assets
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
