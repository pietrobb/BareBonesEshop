RewriteEngine On

# Deny private/runtime/source trees before the generic existing-file bypass.
RewriteRule ^(?:storage|db|jobs|logs|config|cli|src|migrations|adapters|lang|demo|docs|forms|blocks|data|templates)(?:/|$) - [F,L,NC]
RewriteRule ^themes/[^/]+/(?:theme\.json|blocks(?:/|$)) - [F,L,NC]

# BBF's browser client and handler are public integration points; all other
# vendor code stays private. Only the documented import example is public.
RewriteRule ^vendor/(?!bbf/(?:bbf\.(?:css|js)|submit\.php)$) - [F,L,NC]
# Admin forms (forms/admin-*.json) are rendered and saved only by admin.php, so
# BBF's public handler must not serve, issue CSRF for, or accept them.
# BBF reads the form id only from the query string and strips everything except
# [A-Za-z0-9_-], so encoded, padded or junk-laden ids are refused as well.
# Storefront BBF forms (e.g. statutory withdrawal) keep using submit.php.
# <If>, not RewriteRule: vendor/bbf/.htaccess enables its own rewrite engine,
# which replaces these root rewrite rules for everything under vendor/bbf/.
<If "%{REQUEST_URI} =~ m#/vendor/bbf/submit\.php$#i && %{QUERY_STRING} =~ m#[%+]|(?:^|[&;])form=(?:[^&;]*[^A-Za-z0-9_&;-]|admin-)#i">
    Require all denied
</If>
RewriteRule ^import/(?!test-products\.csv$) - [F,L,NC]

# Deny direct cache requests while allowing the explicit api.php rewrites below
# to reach generated JSON internally (THE_REQUEST remains /api.php).
RewriteCond %{THE_REQUEST} "\s/+(?:[^?\s]+/)?cache(?:[/\s?]|$)" [NC]
RewriteRule ^cache(?:/|$) - [F,L,NC]

# Keep ACME validation and security.txt available, deny all other dotfiles.
RewriteRule ^\.well-known/(?:acme-challenge/[A-Za-z0-9_-]+|security\.txt)$ - [L,NC]
RewriteRule (?:^|/)\. - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|stores\.json|catalog\.json|shipping\.json|tax\.json|pricing\.json|layouts\.json|admin-roles\.json|models\.yaml|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]
RewriteRule \.(?:(?:sqlite3?|db)(?:-(?:wal|shm))?|wal|shm|sql|dump|bak|backup|log|lock|ini|ya?ml|pem|key|md)$ - [F,L,NC]

# Uploaded content must never be dispatched through a PHP handler.
RewriteRule ^uploads/.*\.(?:php(?:[0-9]+|s)?|phtml?|phar)(?:[./]|$) - [F,L,NC]

# ============================================================
# Level 0 Cache — serve cached JSON directly (bypass PHP)
# ============================================================

# Category listings with locale: api.php?action=products&cat=tricka&page=1&locale=de
RewriteCond %{QUERY_STRING} action=products&cat=([a-z0-9-]+)&page=(\d+)&locale=([a-z]{2})
RewriteCond %{DOCUMENT_ROOT}/cache/%3/cat/%1/page-%2.json -f
RewriteRule ^api\.php$ cache/%3/cat/%1/page-%2.json [L,T=application/json]

# Category listings (default locale): api.php?action=products&cat=tricka&page=1
RewriteCond %{QUERY_STRING} action=products&cat=([a-z0-9-]+)&page=(\d+)
RewriteCond %{QUERY_STRING} !locale=
RewriteCond %{DOCUMENT_ROOT}/cache/sk/cat/%1/page-%2.json -f
RewriteRule ^api\.php$ cache/sk/cat/%1/page-%2.json [L,T=application/json]

# Categories listing with locale
RewriteCond %{QUERY_STRING} action=categories&locale=([a-z]{2})
RewriteCond %{DOCUMENT_ROOT}/cache/%1/categories.json -f
RewriteRule ^api\.php$ cache/%1/categories.json [L,T=application/json]

# Categories listing (default locale)
RewriteCond %{QUERY_STRING} action=categories
RewriteCond %{QUERY_STRING} !locale=
RewriteCond %{DOCUMENT_ROOT}/cache/sk/categories.json -f
RewriteRule ^api\.php$ cache/sk/categories.json [L,T=application/json]

# ============================================================
# SEO-friendly URLs
# ============================================================

# XML sitemap, robots.txt, and store-scoped commerce feeds
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^feeds/google\.xml$ feed.php?channel=google [QSA,L]
RewriteRule ^feeds/meta\.csv$ feed.php?channel=meta [QSA,L]

# ============================================================
# Multi-store URL prefixes: /de/..., /en/...
# ============================================================
RewriteRule ^de/product/([a-z0-9-]+)/?$ product.php?slug=$1&store=de [QSA,L]
RewriteRule ^de/category/([a-z0-9/-]+)/?$ index.php?category=$1&store=de [QSA,L]
RewriteRule ^de/page/([a-z0-9-]+)/?$ page.php?slug=$1&store=de [QSA,L]
RewriteRule ^de/?$ index.php?store=de [QSA,L]

RewriteRule ^en/product/([a-z0-9-]+)/?$ product.php?slug=$1&store=us [QSA,L]
RewriteRule ^en/category/([a-z0-9/-]+)/?$ index.php?category=$1&store=us [QSA,L]
RewriteRule ^en/page/([a-z0-9-]+)/?$ page.php?slug=$1&store=us [QSA,L]
RewriteRule ^en/?$ index.php?store=us [QSA,L]

# Product detail: /product/brzdovy-kotuc-predny → product.php?slug=brzdovy-kotuc-predny
RewriteRule ^product/([a-z0-9-]+)/?$ product.php?slug=$1 [QSA,L]

# Category: /category/brzdovy-system → index.php?category=brzdovy-system
RewriteRule ^category/([a-z0-9/-]+)/?$ index.php?category=$1 [QSA,L]

# CMS Page: /page/about → page.php?slug=about
RewriteRule ^page/([a-z0-9-]+)/?$ page.php?slug=$1 [QSA,L]

# Wishlist: /wishlist → wishlist.php
RewriteRule ^wishlist/?$ wishlist.php [QSA,L]

# Public load-balancer probes expose no configuration or exception detail.
RewriteRule ^(?:healthz|readyz)$ health.php [QSA,L]

# Versioned machine API keeps path semantics; legacy browser API stays action-based.
RewriteRule ^api/v1(?:/.*)?$ api/v1/index.php [QSA,L]
# API routing: /api/products → api.php?action=products
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

# ============================================================
# Static assets — skip rewriting; never expose directory listings
# ============================================================
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.+/?$ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Exact-path redirects managed in admin; unmatched paths remain a real 404.
RewriteRule ^(.+)$ redirect.php?path=/$1 [QSA,L]

# ============================================================
# Compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ============================================================
# Cache headers for static assets
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
