RewriteEngine On

# Deny private/runtime/source trees before the generic existing-file bypass.
# cache/ is read only through PHP; matched on the decoded path, so /c%61che/ is denied as well.
RewriteRule ^(?:storage|db|jobs|logs|config|cli|src|migrations|adapters|extensions|lang|demo|docs|forms|blocks|data|templates|releases|tests|deploy|cache|node_modules|test-results|playwright-report|parity-report)(?:/|$) - [F,L,NC]
RewriteRule ^themes/[^/]+/(?:theme\.json|blocks(?:/|$)) - [F,L,NC]

# Only BBF's browser assets are public; all other vendor code stays private. The shop
# embeds BBF (admin forms render and save through admin.php), so BBF's own handler
# submit.php is private too: it would serve BBF's bundled demo/contact/upload forms.
RewriteRule ^vendor/(?!bbf/bbf\.(?:css|js)$) - [F,L,NC]
# On Apache that rule never sees vendor/bbf/*: vendor/bbf/.htaccess turns on its own
# rewrite engine, which replaces the root rules there (editor.php, viewer.php, demos...
# were served). The <If> authz block applies below it as well. Only existing files and
# directories are matched, so storefront URLs with a "vendor" segment keep working.
<If "(-f %{REQUEST_FILENAME} || -d %{REQUEST_FILENAME}) && %{REQUEST_URI} =~ m#/vendor/(?!bbf/bbf\.(?:css|js)$)#i">
    Require all denied
</If>
RewriteRule ^import/(?!test-products\.csv$) - [F,L,NC]

# Keep ACME validation and security.txt available, deny all other dotfiles.
RewriteRule ^\.well-known/(?:acme-challenge/[A-Za-z0-9_-]+|security\.txt)$ - [L,NC]
RewriteRule (?:^|/)\. - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|router\.php|stores\.json|catalog\.json|shipping\.json|tax\.json|pricing\.json|layouts\.json|admin-roles\.json|models\.yaml|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]
RewriteRule \.(?:(?:sqlite3?|db)(?:-(?:wal|shm))?|wal|shm|sql|dump|bak|backup|log|lock|ini|ya?ml|pem|key|md|neon(?:\.dist)?)$ - [F,L,NC]

# Uploaded content must never be dispatched through a PHP handler.
RewriteRule ^uploads/.*\.(?:php(?:[0-9]+|s)?|phtml?|phar)(?:[./]|$) - [F,L,NC]

# No web-server cache shortcut: the API serves its file cache itself, because entries live under
# the resolved store namespace (cache/stores/<store>/<channel>/...) and are skipped for logged-in
# customers with personal prices — neither is visible to Apache.

# ============================================================
# SEO-friendly URLs
# ============================================================

# XML sitemap, robots.txt, and store-scoped commerce feeds
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^sitemap-([0-9]+)\.xml$ sitemap.php?part=$1 [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^feeds/google\.xml$ feed.php?channel=google [QSA,L]
RewriteRule ^feeds/meta\.csv$ feed.php?channel=meta [QSA,L]

# Store URL prefixes (/cs/..., /de/..., any url_prefix in stores.json) are served by the
# redirect.php fallback below (UrlAliases::storeRoute), so adding a store needs no rule here.

# Product detail: /product/ceramic-mug-blue → product.php?slug=ceramic-mug-blue
RewriteRule ^product/([a-z0-9-]+)/?$ product.php?slug=$1 [QSA,L]

# Category: /category/kitchen → index.php?category=kitchen
RewriteRule ^category/([a-z0-9/-]+)/?$ index.php?category=$1 [QSA,L]

# CMS Page: /page/about → page.php?slug=about
RewriteRule ^page/([a-z0-9-]+)/?$ page.php?slug=$1 [QSA,L]

# Wishlist: /wishlist → wishlist.php
RewriteRule ^wishlist/?$ wishlist.php [QSA,L]

# Public load-balancer probes expose no configuration or exception detail.
RewriteRule ^(?:healthz|readyz)$ health.php [QSA,L]

# The single JSON API: storefront, options, webhooks, CSP reports and the external API (src/ApiRoute.php).
RewriteRule ^api/v1(?:/.*)?$ api/v1/index.php [QSA,L]

# ============================================================
# Static assets — skip rewriting; never expose directory listings
# ============================================================
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.+/?$ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Exact-path redirects managed in admin; unmatched paths remain a real 404.
RewriteRule ^(.+)$ redirect.php?path=/$1 [QSA,L]

# ============================================================
# Security headers for files Apache serves itself. PHP responses send their own
# (Security::headers(), with the page CSP), so the block does not match .php.
# An upload is sandboxed: an SVG opened directly cannot run script on the shop origin.
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(?i:css|js|mjs|map|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|txt|csv|pdf|xml|json|webmanifest)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set X-Frame-Options "DENY"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    </FilesMatch>
    <If "%{REQUEST_FILENAME} =~ m#/uploads/#">
        Header always set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
    </If>
</IfModule>

# ============================================================
# Compression
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ============================================================
# Cache headers for static assets
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
