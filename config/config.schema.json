{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bareboneseshop:config:v1",
  "title": "BareBonesEshop deployment configuration",
  "type": "object",
  "required": ["db_driver", "private_runtime_dir", "provider_defaults", "providers", "adapters"],
  "properties": {
    "db_driver": {"type": "string", "enum": ["sqlite", "mysql"]},
    "private_runtime_dir": {"type": "string", "minLength": 1, "x-private-path": true},
    "db_sqlite_path": {"type": "string", "minLength": 1, "x-private-path": true},
    "db_host": {"type": "string"},
    "db_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "db_name": {"type": "string"},
    "db_user": {"type": "string"},
    "db_password": {"type": "string", "x-secret": true},
    "db_charset": {"type": "string", "const": "utf8mb4"},
    "app_url": {"oneOf": [{"const": ""}, {"type": "string", "format": "uri"}]},
    "admin_password": {"type": "string", "x-secret": true},
    "admin_identity_key": {"type": "string", "x-secret": true},
    "admin_session_idle_seconds": {"type": "integer", "minimum": 300, "maximum": 86400},
    "admin_session_lifetime_seconds": {"type": "integer", "minimum": 1800, "maximum": 604800},
    "api_client_rate_limit": {"type": "integer", "minimum": 1, "description": "External API v1: requests per minute per API key, across all source addresses (default 600)"},
    "checkout_global_limit": {"type": "integer", "minimum": 0, "description": "Optional shop-wide cap on checkout attempts per minute (default 0 = off); refused attempts never count"},
    "private_cache_dir": {"type": "string", "x-private-path": true},
    "jobs_dir": {"type": "string", "x-private-path": true},
    "invoice_storage_dir": {"type": "string", "x-private-path": true},
    "backup_storage_dir": {"type": "string", "x-private-path": true},
    "backup_log_file": {"type": "string", "x-private-path": true},
    "structured_log_file": {"type": "string", "x-private-path": true},
    "structured_log_max_bytes": {"type": "integer", "minimum": 0, "description": "Rotate the structured log at this size in bytes; 0 disables rotation."},
    "structured_log_max_files": {"type": "integer", "minimum": 1, "maximum": 100, "description": "Rotated structured log files kept (application.jsonl.1 … .N)."},
    "default_locale": {"type": "string", "pattern": "^[a-z]{2}(?:[-_][A-Za-z]{2})?$"},
    "default_currency": {"type": "string", "pattern": "^[a-z]{3}$"},
    "prices_include_tax": {"type": "boolean"},
    "per_page": {"type": "integer", "minimum": 1, "maximum": 200},
    "cache_dir": {"type": "string", "minLength": 1},
    "cache_ttl": {"type": "integer", "minimum": 0},
    "pending_order_expiry_seconds": {"type": "integer", "minimum": 0},
    "pending_order_expiry_batch": {"type": "integer", "minimum": 1},
    "offline_order_expiry_seconds": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "admin_name": {"type": "string"},
    "admin_user": {"type": "string"},
    "admin_email": {"type": "string"},
    "merchant_notifications": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "recipients": {"type": "array", "items": {"type": "string"}}, "events": {"type": "object", "additionalProperties": {"type": "boolean"}}, "templates": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": true},
    "cart_reminder": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "delay_hours": {"type": "integer", "minimum": 1}, "max_age_hours": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "url_aliases": {"type": ["array", "object"]},
    "drift_guard": {"type": "object", "properties": {"recipients": {"type": "array", "items": {"type": "string"}}, "exclude": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "stock_alerts": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "low": {"type": "integer", "minimum": 0}, "critical": {"type": "integer", "minimum": 0}, "recipients": {"type": "array", "items": {"type": "string"}}, "digest_hour": {"type": ["integer", "null"], "minimum": 0, "maximum": 23}, "locale": {"type": "string"}}, "additionalProperties": true},
    "trusted_proxies": {"type": "array", "items": {"type": "string"}, "description": "REMOTE_ADDR values of reverse proxies whose X-Forwarded-For is trusted; also disables the raw-count CSP form-action fallback alarm."},
    "incident_alerts": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "recipients": {"type": "array", "items": {"type": "string"}}, "locale": {"type": "string"}, "window_seconds": {"type": "integer", "minimum": 1}, "checkout_failures": {"type": "integer", "minimum": 1}, "cooldown_seconds": {"type": "integer", "minimum": 1}, "lease_seconds": {"type": "integer", "minimum": 1}, "heartbeat_max_age_seconds": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "monitoring": {"type": "object", "properties": {"backup_rpo_seconds": {"type": "integer", "minimum": 0}, "queue_pending_warning": {"type": "integer", "minimum": 0}, "failed_jobs_warning": {"type": "integer", "minimum": 0}, "failed_mail_warning": {"type": "integer", "minimum": 0}, "payment_incidents_critical": {"type": "integer", "minimum": 0}, "webhook_incidents_warning": {"type": "integer", "minimum": 0}, "payment_funnel_window_seconds": {"type": "integer", "minimum": 0}, "payment_funnel_grace_seconds": {"type": "integer", "minimum": 0}, "payment_funnel_min_started": {"type": "integer", "minimum": 0}, "csp_window_seconds": {"type": "integer", "minimum": 0}, "csp_form_action_critical": {"type": "integer", "minimum": 0}, "csp_form_action_reports_critical": {"type": "integer", "minimum": 0}, "csp_violations_warning": {"type": "integer", "minimum": 0}, "synthetic_token": {"oneOf": [{"const": ""}, {"type": "string", "minLength": 32}], "x-secret": true}}, "additionalProperties": false},
    "allow_mock_webhook": {"type": "boolean"},
    "mock_webhook_secret": {"type": "string", "x-secret": true},
    "shipping_webhook_secrets": {"type": "object", "additionalProperties": {"type": "string"}, "x-secret": true},
    "shipping_webhook_require_timestamp": {"type": "boolean"},
    "outbox_sweep_budget_seconds": {"type": "integer", "minimum": 1},
    "stripe_secret_key": {"type": "string", "x-secret": true},
    "stripe_publishable_key": {"type": "string"},
    "stripe_webhook_secret": {"type": "string", "x-secret": true},
    "gopay_goid": {"type": "string"},
    "gopay_client_id": {"type": "string"},
    "gopay_client_secret": {"type": "string", "x-secret": true},
    "gopay_env": {"type": "string", "enum": ["sandbox", "production"]},
    "comgate_merchant": {"type": "string"},
    "comgate_secret": {"type": "string", "x-secret": true},
    "comgate_test": {"type": "boolean"},
    "thepay_merchant_id": {"type": "string"},
    "thepay_project_id": {"type": "string"},
    "thepay_password": {"type": "string", "x-secret": true},
    "thepay_env": {"type": "string", "enum": ["demo", "production"]},
    "payu_client_id": {"type": "string"},
    "payu_client_secret": {"type": "string", "x-secret": true},
    "payu_second_key": {"type": "string", "x-secret": true},
    "payu_pos_id": {"type": "string"},
    "payu_env": {"type": "string", "enum": ["sandbox", "production"]},
    "digital_assets_base_dir": {"type": "string", "x-private-path": true},
    "digital_download_resume_minutes": {"type": "integer", "minimum": 0},
    "rma_return_window_days": {"type": "integer", "minimum": 0, "description": "Days after delivery a customer can request a return (0 = no limit)."},
    "uploads_dir": {"type": "string", "minLength": 1, "description": "Product image uploads (LocalStorage adapter) and the uploads part of file backups; served at uploads_url."},
    "uploads_url": {"type": "string"},
    "checkout_consents": {
      "type": ["array", "object"],
      "description": "Checkout consent checkboxes keyed by consent code.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {"type": "string"},
          "required": {"type": "boolean"},
          "active": {"type": "boolean"},
          "text": {
            "oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": {"type": "string"}}],
            "description": "Label text: one string for every locale, or a {locale: text} map (e.g. {\"sk\": \"...\", \"en\": \"...\"}); a missing locale falls back to the store default locale, then en."
          },
          "url": {"type": "string", "description": "https:// URL, or a shop path such as /?page=terms that is prefixed with the store URL (/cs/?page=terms)."},
          "countries": {"type": "array", "items": {"type": "string"}},
          "product_types": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "backup_storage_adapter": {"type": "string", "enum": ["LocalBackupStorage", "MountedBackupStorage"]},
    "backup_recovery_dir": {"type": "string", "x-private-path": true},
    "metrics_log_file": {"type": "string", "x-private-path": true},
    "update_storage_dir": {"type": "string", "x-private-path": true},
    "update_public_key": {"type": "string"},
    "update_snapshots_keep": {"type": "integer", "minimum": 1, "description": "Newest pre-update snapshots (each a full database copy) kept after an update; older ones are deleted."},
    "update_mysql_probe_database": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "_update_probe$"}]},
    "update_mysql_dump_binary": {"type": "string", "minLength": 1, "description": "mysqldump, or mariadb-dump on MariaDB-only hosts"},
    "update_mysql_client_binary": {"type": "string", "minLength": 1, "description": "mysql, or mariadb on MariaDB-only hosts"},
    "backup_mysql_restore_scratch_database": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "_restore_scratch$"}]},
    "gdpr_salt_file": {"type": "string", "x-private-path": true},
    "gdpr_hash_salt": {"type": "string", "x-secret": true},
    "mock_result": {"type": "string", "x-internal": true},
    "mock_checkout_url": {"type": "string", "x-internal": true},
    "mock_refund_result": {"type": "string", "x-internal": true},
    "benchmark_query_count": {"type": "boolean", "x-internal": true},
    "log_file": {"type": "string", "x-internal": true, "description": "LogMail (development mail adapter) capture file; default <private_runtime_dir>/logs/emails.log"},
    "log_max_bytes": {"type": "integer", "minimum": 1024, "x-internal": true, "description": "LogMail rotates the capture file to <log_file>.1 once it reaches this size (default 5 MiB)"},
    "benchmark_fixture_version": {"type": "string", "x-internal": true},
    "adapters": {
      "type": "object",
      "properties": {
        "search": {"type": "string"},
        "queue": {"type": "string"},
        "payment": {"type": "string"},
        "vat_validator": {"type": "string"},
        "storage": {"type": "string"},
        "integration": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "provider_defaults": {
      "type": "object",
      "properties": {
        "payment": {"$ref": "#/$defs/providerCode"},
        "mail": {"$ref": "#/$defs/providerCode"},
        "tax": {"$ref": "#/$defs/providerCode"},
        "shipping": {"$ref": "#/$defs/providerCode"},
        "erp": {"$ref": "#/$defs/providerCode"}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "payment": {"$ref": "#/$defs/providerMap"},
        "shipping": {"$ref": "#/$defs/providerMap"},
        "mail": {"$ref": "#/$defs/providerMap"},
        "tax": {"$ref": "#/$defs/providerMap"},
        "erp": {"$ref": "#/$defs/providerMap"}
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "http_shipping": {"$ref": "#/$defs/httpIntegration"},
        "http_erp": {"$ref": "#/$defs/httpIntegration"}
      },
      "additionalProperties": true
    },
    "outbound_webhooks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "secret", "events"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "secret": {"type": "string", "minLength": 32, "x-secret": true},
          "events": {"type": "array", "items": {"type": "string"}},
          "stores": {"type": "array", "items": {"$ref": "#/$defs/providerCode"}},
          "active": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "queue": {
      "type": "object",
      "properties": {
        "backend": {"type": "string", "enum": ["file", "database", "redis"]},
        "lease_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "redis": {
          "type": "object",
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "database": {"type": "integer", "minimum": 0},
            "password": {"type": "string", "x-secret": true},
            "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
            "prefix": {"type": "string", "pattern": "^[A-Za-z0-9:_-]{1,80}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "properties": {
        "worker_cron": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "^(?:\\S+\\s+){4}\\S+$"}]},
        "nginx_config": {"type": "string", "description": "Absolute path of the live nginx site config; doctor/preflight check its PHP location for the @redirect fallback. Empty: not checked."},
        "document_root": {"type": "string", "description": "Directory the web server serves when the shop is installed in a subdirectory of it; doctor/preflight fail private paths inside it. Empty: guessed from the directory name (public_html, httpdocs, htdocs, wwwroot, html, www, web)."},
        "monitor_cron": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "^(?:\\S+\\s+){4}\\S+$"}]}
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "providerCode": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"},
    "providerMap": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/providerCode"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["class"],
            "properties": {
              "class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "capabilities": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "httpIntegration": {
      "type": "object",
      "required": ["base_url", "api_key"],
      "properties": {
        "base_url": {"oneOf": [{"const": ""}, {"type": "string", "format": "uri", "pattern": "^https://"}]},
        "api_key": {"oneOf": [{"const": ""}, {"type": "string", "minLength": 16}], "x-secret": true},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 60},
        "carrier_code": {"$ref": "#/$defs/providerCode"},
        "supports_cod": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
