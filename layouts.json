{
    "layouts": {
        "one-column":  {"slots": ["full"]},
        "two-column":  {"slots": ["main", "sidebar"], "ratios": ["3fr", "1fr"]},
        "two-column-left": {"slots": ["sidebar", "main"], "ratios": ["1fr", "3fr"]},
        "three-column": {"slots": ["left", "main", "right"], "ratios": ["1fr", "3fr", "1fr"]}
    },

    "pages": {
        "homepage": {
            "layout": "one-column",
            "sections": [
                {"block": "homepage/hero-banner", "data": "banners"},
                {"block": "homepage/featured-categories", "data": "categories.featured"},
                {"block": "product/product-grid", "data": "products.new", "title": {"sk": "Novinky", "en": "New Arrivals", "de": "Neuheiten"}},
                {"block": "product/product-grid", "data": "products.sale", "title": {"sk": "Výpredaj", "en": "Sale", "de": "Angebote"}},
                {"block": "global/newsletter-signup"}
            ]
        },

        "product": {
            "layout": "one-column",
            "sections": [
                {"block": "global/breadcrumb"},
                {"block": "product/product-gallery"},
                {"block": "product/product-info"},
                {"block": "product/product-tabs"},
                {"block": "product/related-products"},
                {"block": "product/recently-viewed"}
            ]
        },

        "cms": {
            "layout": "one-column",
            "sections": [
                {"block": "global/breadcrumb"},
                {"block": "cms/cms-content"}
            ]
        }
    }
}
