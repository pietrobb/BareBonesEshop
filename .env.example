# BareBones Shop — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# ── Stripe ────────────────────────────────────────────────────
PAY_STRIPE_SK=sk_test_...
PAY_STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayU ──────────────────────────────────────────────────────
# PAY_PAYU_ENV: 'sandbox' (default) or 'production'
PAY_PAYU_CLIENT_ID=your_pos_id
PAY_PAYU_CLIENT_SECRET=your_client_secret
PAY_PAYU_POS_ID=your_pos_id
PAY_PAYU_ENV=sandbox

# ── Shipping — Packeta (Zásilkovna) ───────────────────────────
SHIP_PACKETA_API_KEY=your_packeta_api_key
SHIP_PACKETA_FREE_ABOVE=5000
# SHIP_PACKETA_WEBHOOK_SECRET=your_webhook_secret (optional, enables sig verification)

# ── Shipping — GLS ────────────────────────────────────────────
SHIP_GLS_CLIENT_ID=your_gls_client_id
SHIP_GLS_CLIENT_SECRET=your_gls_client_secret
SHIP_GLS_FREE_ABOVE=7500
# SHIP_GLS_WEBHOOK_SECRET=your_webhook_secret

# ── Email ─────────────────────────────────────────────────────
# MAIL_ADAPTER: 'log' (dev default, captures to logs/mail.log), 'smtp', 'ses'
MAIL_ADAPTER=log
MAIL_FROM=noreply@yourshop.example.com
MAIL_FROM_NAME=Your Shop

# SMTP (when MAIL_ADAPTER=smtp) — AUTH LOGIN + STARTTLS on port 587
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_SECURE=tls

# AWS SES (when MAIL_ADAPTER=ses) — SigV4 to email.<region>.amazonaws.com
AWS_SES_REGION=eu-central-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_URL=https://yourshop.example.com
