# BareBones Shop — process environment variables
#
# These values are not read from a .env file: nothing in the application loads one.
# Set them in the process environment of PHP (php-fpm pool `env[NAME] = value`,
# Apache `SetEnv`, `environment:` in docker compose, systemd `Environment=`) or for a
# single CLI command (`NAME=value php cli/...`). Every other setting, including the
# Stripe keys, carrier credentials and app_url, lives in config.php (see
# config.example.php and config/config.schema.json; `x-secret` fields belong in
# deployment secret storage).

# ── Admin identity ────────────────────────────────────────────
# Overrides config.php admin_identity_key (32-byte base64/hex; encrypts TOTP seeds).
BBE_ADMIN_IDENTITY_KEY=
# CLI only: password for `cli/admin-user.php create|password` and
# `cli/setup.php install --admin-username=...` (never passed as an argument).
BBE_ADMIN_PASSWORD=

# ── Email ─────────────────────────────────────────────────────
# MAIL_ADAPTER: provider code, e.g. 'log' (dev default), 'smtp', 'ses';
# overrides config.php provider_defaults.mail.
MAIL_ADAPTER=log
MAIL_FROM=noreply@yourshop.example.com
MAIL_REPLY_TO=

# SMTP (MAIL_ADAPTER=smtp) — each falls back to the lower-case key in the adapter config
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10
SMTP_VERIFY_PEER=1

# Amazon SES (MAIL_ADAPTER=ses) — SigV4 to email.<region>.amazonaws.com
MAIL_SES_REGION=eu-central-1
MAIL_SES_KEY=
MAIL_SES_SECRET=

# ── PayU ──────────────────────────────────────────────────────
# Each overrides the matching payu_* key in config.php. PAY_PAYU_ENV: sandbox|production
PAY_PAYU_CLIENT_ID=
PAY_PAYU_CLIENT_SECRET=
PAY_PAYU_SECOND_KEY=
PAY_PAYU_POS_ID=
PAY_PAYU_ENV=sandbox

# ── Shipping webhooks ─────────────────────────────────────────
# SHIP_<CARRIER>_WEBHOOK_SECRET overrides config.php shipping_webhook_secrets.<carrier>.
# SHIP_PACKETA_WEBHOOK_SECRET=
# SHIP_GLS_WEBHOOK_SECRET=

# ── Signed updates ────────────────────────────────────────────
# BAREBONES_UPDATE_PUBLIC_KEY overrides update_public_key for cli/update.php;
# BAREBONES_UPDATE_SECRET_KEY is read by cli/build-update.php on the build machine only.
# BAREBONES_UPDATE_PUBLIC_KEY=
# BAREBONES_UPDATE_SECRET_KEY=

# ── Tests ─────────────────────────────────────────────────────
# cli/test.php: optional HTTP smoke target and native MySQL/MariaDB runs.
# SMOKE_URL=http://localhost:8080
# TEST_MYSQL_DSN=mysql:host=127.0.0.1;port=3306;dbname=barebone_shop_test;charset=utf8mb4
# TEST_MYSQL_USER=root
# TEST_MYSQL_PASS=
