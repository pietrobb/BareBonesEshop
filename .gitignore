# Database
db/*.sqlite
db/*.sqlite-wal
db/*.sqlite-shm
db/.migrations.lock

# Cache
cache/
!cache/.gitkeep

# Rate limit DB
rate_limit.sqlite*

# Jobs
jobs/pending/*
jobs/processing/*
jobs/completed/*
jobs/failed/*
!jobs/pending/.gitkeep
!jobs/processing/.gitkeep
!jobs/completed/.gitkeep
!jobs/failed/.gitkeep

# Uploads
uploads/thumb/*
uploads/medium/*
uploads/full/*
uploads/magento/
!uploads/thumb/.gitkeep
!uploads/medium/.gitkeep
!uploads/full/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Large data files (TecDoc DB ~850MB)
demo/*.db

# Storage (invoices PDFs, etc.)
storage/invoices/*
!storage/invoices/.gitkeep
!storage/.gitkeep

# Environment
.env
