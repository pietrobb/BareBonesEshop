{
  "name": "BareBones Default",
  "version": "2.3.0",
  "description": "Accessible, mobile-first default storefront package",
  "blocks": "blocks",
  "assets": {
    "css": ["accessibility.css", "storefront.css"],
    "js": ["storefront.js"]
  },
  "sections": {
    "product-page": "storefront/product-page",
    "account-page": "storefront/account-page",
    "wishlist-page": "storefront/wishlist-page",
    "hero": "storefront/section-hero",
    "category-list": "storefront/section-category-list",
    "product-list": "storefront/section-product-list",
    "rich-text": "storefront/section-rich-text"
  },
  "performance_budgets": {
    "css_bytes": 153600,
    "js_bytes": 102400,
    "block_bytes": 81920
  },
  "quality": {
    "wcag": "2.2 AA",
    "minimum_target_px": 24,
    "requires_reduced_motion": true
  }
}
